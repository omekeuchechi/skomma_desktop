# Skomma Desktop environment variables
# Copy this file to .env and adjust the values. Never commit .env.

# Base URL of the Skomma server API
VITE_API_URL=http://localhost:3000/api/v1

# WebSocket URL of the Skomma server
VITE_WS_URL=ws://localhost:3000/api/v1

# Application name shown in the UI
VITE_APP_NAME=Skomma
